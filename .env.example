# OpenRouter API Key — get from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model to use (default: claude-3-haiku for speed)
OPENROUTER_MODEL=anthropic/claude-3-haiku

# Optional: path to kubeconfig file (defaults to ~/.kube/config)
KUBECONFIG_PATH=

# ── Production deployment only (DigitalOcean) ──────────────
# Your Docker Hub username (used to pull prebuilt images)
DOCKER_HUB_USERNAME=

# Your droplet's public IP (used by frontend to reach backend)
DROPLET_HOST=
